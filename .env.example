# 数据库（MySQL 5.7，utf8mb4）
DATABASE_URL="mysql://root:密码@127.0.0.1:3306/huodongpeitai"

# 媒体存储根目录（本地驱动时生效；生产建议绝对路径）
MEDIA_ROOT="./media"

# 会话签名密钥：openssl rand -hex 32
